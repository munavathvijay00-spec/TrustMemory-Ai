{
  "name": "trustmemory-ai",
  "version": "1.0.0",
  "description": "TrustMemory AI - Outbound Voice Agent and Institutional Memory for Home-Care Agencies",
  "main": "server/index.js",
  "license": "MIT",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "dev": "node server/index.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node --test test/browser.e2e.js",
    "lint": "eslint server test TrustMemory-AI-modular/js eslint.config.js",
    "typecheck": "tsc -p tsconfig.json",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"server/**\" --test-coverage-lines=75 test/*.test.js",
    "seed:memory": "node server/seed-memory.js",
    "seed:memory:dry": "node server/seed-memory.js --dry-run",
    "bank:reset": "node server/reset-bank.js",
    "eval:memory": "node server/eval-memory.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "puppeteer-core": "^24.43.1",
    "typescript": "^5.9.3"
  }
}
