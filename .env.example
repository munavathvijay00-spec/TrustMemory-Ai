# Application Settings
PROJECT_NAME="TrustMemory AI"
ENVIRONMENT="development"
DEBUG=true
PORT=3000
# Listen address. 127.0.0.1 keeps the API on this machine; use 0.0.0.0 only on a trusted network.
HOST=127.0.0.1

# LLM (agent brain) — free key from https://console.groq.com
GROQ_API_KEY=""
# Optional pool of keys from different teammates' accounts, comma-separated. Rotated on rate limit.
GROQ_API_KEYS=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_FALLBACK_MODEL="openai/gpt-oss-20b"

# Hindsight memory — Cloud (https://ui.hindsight.vectorize.io) or self-hosted (http://localhost:8888)
HINDSIGHT_API_URL="https://api.hindsight.vectorize.io"
HINDSIGHT_API_KEY=""
HINDSIGHT_BANK_ID="trustmemory-agency"

# Sign-in. Set to "off" only for local experiments; the console then runs as the coordinator with no login.
TRUSTMEMORY_AUTH="on"
# Demo accounts seeded at startup: coordinator@trustmemory.demo, radha@trustmemory.demo (helper),
# gupta@trustmemory.demo (household). Leave empty to have random passwords generated and printed once.
DEMO_COORDINATOR_PASSWORD=""
DEMO_HELPER_PASSWORD=""
DEMO_HOUSEHOLD_PASSWORD=""

# Optional: Azure AI Speech neural voices for Hindi and Telugu on the helper phone screen.
# Create a Speech resource (free F0 tier) in the Azure portal; leave empty to use the browser's voices.
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""
