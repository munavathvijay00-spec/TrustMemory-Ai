# Application Settings
PROJECT_NAME="TrustMemory AI"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Database
DATABASE_URL="sqlite+aiosqlite:///./trustmemory.db"
# For PostgreSQL / Supabase:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/trustmemory"

# LLM / Groq API
GROQ_API_KEY="gsk_mock_key_for_development"
GROQ_MODEL="llama-3.1-70b-versatile"

# Memory Core / Hindsight API
HINDSIGHT_API_URL="https://api.hindsight.vectorize.io"
HINDSIGHT_API_KEY="hindsight_mock_key"

# Voice Agent / Vapi / Bland
VAPI_API_KEY="vapi_mock_key"
VAPI_ASSISTANT_ID="asst_mock_id"
BLAND_API_KEY="bland_mock_key"

# Security
SECRET_KEY="dev_super_secret_signing_key_change_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Email / Gmail SMTP Configuration
GOOGLEUSER="your_email@gmail.com"
GMAIL_APP_PASSWORD="abcdefghijklmnop"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
COORDINATOR_ALERT_EMAIL="coordinator@agency.com"

# Google Login / OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

